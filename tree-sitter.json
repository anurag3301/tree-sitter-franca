{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "franca",
      "camelcase": "Franca",
      "title": "Franca IDL",
      "scope": "source.franca",
      "file-types": [
        "fidl"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^franca$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Franca IDL grammar for tree-sitter",
    "authors": [
      {
        "name": "Anurag Kumar Singh"
      }
    ],
    "links": {
      "repository": "https://github.com/anurag3301/tree-sitter-franca"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
